#!/bin/sh
# =============================================================================
#  commit-msg — authorship gate for PUBLIC repos (hecate-meta RS11, RS12).
#
#  Commits are authored by the human maintainer. This gate refuses, at commit
#  time:
#    - any Co-Authored-By / Signed-off-by / Reviewed-by trailer (this project
#      has one maintainer; a co-author line is never expected here),
#    - any "Generated with …" line or robot marker,
#    - an author or committer whose address is a vendor no-reply address or a
#      bot account.
#
#  This variant deliberately names no tool: a public repo shows the project and
#  the person who answers for it, nothing else (RS11-1). Canonical copy:
#  hecate-meta/tools/hooks/commit-msg.public, installed as .githooks/commit-msg
#  and activated with `make hooks` (core.hooksPath = .githooks).
# =============================================================================
set -u
MSG_FILE="$1"

fail() {
  echo "commit-msg: refusing — $1" >&2
  echo "            Rule: CONTRIBUTING.md, Authorship." >&2
  exit 1
}

if grep -qiE '^[[:space:]]*(co-authored-by|signed-off-by|reviewed-by|authored-by|generated-by):' "$MSG_FILE"; then
  fail "a trailer credits a co-author or generator; commits here carry one author."
fi

if grep -qiE '(generated (with|by)|🤖)' "$MSG_FILE"; then
  fail "the message says it was generated by a tool."
fi

for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  ident="$(git var "$var" 2>/dev/null || true)"
  if printf '%s' "$ident" | grep -qiE '\[bot\]'; then
    fail "the ${var#GIT_} is a bot identity."
  fi
  # A vendor no-reply address is a tool; GitHub's own users.noreply address is a person.
  if printf '%s' "$ident" | grep -qiE 'noreply@' && ! printf '%s' "$ident" | grep -qiE 'users\.noreply\.github\.com'; then
    fail "the ${var#GIT_} is a vendor no-reply identity."
  fi
done
exit 0
