#!/bin/sh
# =============================================================================
#  pre-push-authorship — the second line of the authorship gate (RS12-3).
#
#  commit-msg refuses an AI-credited commit when it is made. This scan refuses
#  the PUSH if such a commit is in the range about to leave the machine anyway:
#  made with --no-verify, in a clone without core.hooksPath, or before the hook
#  existed. It reuses the repo's own .githooks/commit-msg as the policy, so the
#  private and the public variant need no second rule set here.
#
#  Install as .githooks/pre-push where the repo has none, or call it from an
#  existing pre-push first thing:
#
#      tmp="$(mktemp)"; cat > "$tmp"
#      sh .githooks/pre-push-authorship "$@" < "$tmp" || exit 1
#      … the existing checks, reading stdin from "$tmp" …
#
#  Canonical copy: hecate-meta/tools/hooks/pre-push-authorship.
# =============================================================================
set -u
HOOKS_DIR="$(git rev-parse --show-toplevel)/.githooks"
POLICY="$HOOKS_DIR/commit-msg"
if [ ! -x "$POLICY" ] && [ ! -f "$POLICY" ]; then
  echo "pre-push-authorship: no .githooks/commit-msg to apply — install it (hecate-meta: make hooks-sync REPO=…)." >&2
  exit 1
fi
zero="0000000000000000000000000000000000000000"
fail=0
msgfile="$(mktemp)"
trap 'rm -f "$msgfile"' EXIT
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue          # deleting a ref
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                             # new branch: everything not on any remote ref
    excl="$(git for-each-ref --format='^%(objectname)' refs/remotes/ 2>/dev/null)"
  else
    range="$remote_sha..$local_sha"; excl=""
  fi
  # shellcheck disable=SC2086
  for sha in $(git rev-list $range $excl 2>/dev/null); do
    git log -1 --format='%B' "$sha" > "$msgfile"
    # `git var GIT_AUTHOR_IDENT` is built from these four variables, so the
    # policy sees the historic author and committer, not the person pushing.
    GIT_AUTHOR_NAME="$(git log -1 --format='%an' "$sha")" \
    GIT_AUTHOR_EMAIL="$(git log -1 --format='%ae' "$sha")" \
    GIT_COMMITTER_NAME="$(git log -1 --format='%cn' "$sha")" \
    GIT_COMMITTER_EMAIL="$(git log -1 --format='%ce' "$sha")" \
    sh "$POLICY" "$msgfile" >/dev/null 2>&1 || {
      echo "pre-push-authorship: $(git log -1 --format='%h %s' "$sha" | cut -c1-90)" >&2
      fail=1
    }
  done
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push-authorship: refusing the push — the commits above credit an AI or a bot (CONTRIBUTING.md, Authorship)." >&2
  echo "                     Fix: git rebase -i and reword/amend; never push them as they are." >&2
  exit 1
fi
exit 0
